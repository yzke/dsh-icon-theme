{
  "name": "dsh-icon-theme",
  "version": "0.1.0",
  "description": "Auto-detected, user-customizable icons for DeepSeek Harness settings and sidebar surfaces.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "icons",
    "theme"
  ],
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "npm run icons:generate && tsdown && node scripts/normalize-client-banner.mjs",
    "build": "npm run build:host && npm run build:client",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:web": "npm run build && vitest run --config vitest.web.config.ts",
    "preflight": "node scripts/preflight.mjs",
    "qa": "npm run typecheck && npm run test && npm run build && npm run preflight",
    "prepack": "npm run qa"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.2.0-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.2.0-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.2.0-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.2.0-0 || >=0.1.1-rc.0 <0.2.0-0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@fluentui/svg-icons": "1.1.337",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "TESTING.md",
    "docs/design.md",
    "docs/ecosystem-compatibility.md",
    "docs/images",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzke/dsh-icon-theme.git"
  },
  "bugs": {
    "url": "https://github.com/yzke/dsh-icon-theme/issues"
  },
  "homepage": "https://github.com/yzke/dsh-icon-theme#readme"
}
